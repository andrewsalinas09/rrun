#!/usr/bin/env bash
# rrun — run a payload on a remote host with ZERO escaping.
# The payload never rides inside quoted shell strings: it travels as base64
# ([A-Za-z0-9+/=] is inert in every shell) and is decoded only by the shell
# that will execute it. For multi-hop chains, each intermediate ssh command is
# itself re-armored, so quoting depth stays flat no matter how many hops.
#
# usage: rrun [-s ps|bash|sh|wsl] [-J jumphosts] [-n] <host[,host2,...]|adb[:serial]> <script | - | -c "cmds">
#   -s ps|bash|sh|wsl  target shell on the FINAL host (default ps; *.sh/*.bash files -> bash;
#                  adb targets default to sh — Android ships no bash and no PowerShell;
#                  wsl = bash inside WSL on a WINDOWS host: the Windows side is
#                  crossed exactly like ps, then wsl.exe carries the payload inward)
#   -J jumphosts   ssh ProxyJump — preferred for hops when local can auth to the final host
#   -n             dry-run: print the composed invocation (shell-quoted, paste-safe)
#   host,host2     nested-hop chain (use when intermediate hosts hold the keys);
#                  payload runs on the LAST host. Chain hosts after the FIRST
#                  (including the final one) need a POSIX login shell + base64
#                  + sh; the first hop only needs ssh and a login shell that
#                  respects single quotes (csh is fine THERE, not later).
#   adb[:serial]   an Android device over adb instead of ssh. Legal ONLY as the
#                  LAST hop: alone ("adb") the adb client runs locally; as the
#                  tail of a chain ("jump,adb:SERIAL1234") it runs on the preceding
#                  host, so the device may hang off a different machine. Bare
#                  "adb" means adb's own default device (it errors on 0 or 2+).
#
# caveats:
#   * STREAMED bash/sh payloads cannot read stdin (the channel carries the
#     payload). Non-streamed bash/sh payloads read the real ssh channel as of
#     v2.3.3 (they used to read their own script text from the decode pipe).
#     wsl payloads NEVER see the ssh channel stdin (embedded or streamed):
#     the PowerShell bootstrap layer does not forward it to the wsl.exe
#     child, so payload stdin reads get immediate EOF (measured, real host).
#   * payload exit codes pass through UNTOUCHED — rrun reserves nothing. A
#     transport-level decode failure exits 125 AND prints "rrun: ... decode
#     failed" on stderr; the stderr marker (not the number) identifies it.
#   * large payloads (composed command > RRUN_STREAM_LIMIT, default 6000 chars —
#     sized for the 8191-char cmd.exe limit on stock Windows OpenSSH targets)
#     auto-switch to streaming the base64 over stdin; the remote payload then
#     cannot read stdin. Streaming works at ANY hop count (each intermediate
#     ssh forwards stdin to the next), so nested chains carry big payloads too.
#     The limit counts COMPOSED COMMAND chars, not payload bytes, and measures
#     the OUTERMOST command (the binding constraint — every layer carries a
#     command and the outer one is biggest). So the payload size that actually
#     trips streaming is well under the number and shrinks per hop (4/3 each;
#     ps also pays ~2.67x for UTF-16LE+base64). Measured at the default 6000:
#       -s bash  ~4.3KB / ~3.1KB / ~2.2KB   at 1 / 2 / 3 hops
#       -s ps    ~1.5KB / ~1.0KB / ~0.7KB
#     Since streaming costs the payload its stdin, that switch is worth being
#     able to predict: `-n` shows which form was chosen (a streamed dry-run
#     starts "printf %s <b64> | ssh"), and raising RRUN_STREAM_LIMIT (up to
#     RRUN_MAX_CMD) keeps a payload embedded and stdin-capable.
#   * KNOWN ISSUE: streamed sessions to a Windows sshd can nondeterministically
#     wedge remotely before the payload runs (host-side sshd/DefaultShell race,
#     independent of rrun version and payload — see README caveats). Wrap in a
#     timeout + retry, or raise RRUN_STREAM_LIMIT on pwsh-DefaultShell hosts.
#
# history:
#   v1            PowerShell -EncodedCommand only, single hop.
#   v2   2026-08-10 bash/sh targets, comma multi-hop with per-layer re-armoring,
#                 -J, -n, extension autodetect. Class fix per RSI rule.
#   v2.1 2026-08-10 ps payloads get $ProgressPreference prepended (CLIXML noise).
#   v2.2 2026-08-10 external review fixes: stdin-streaming transport for large
#                 payloads (Windows 8191-char command-line ceiling), %q paste-safe
#                 dry-run, host-token validation, -s validation, missing-optarg
#                 errors, cat --, size guard on multi-hop ps targets.
#   v2.2.1 2026-08-10 streaming ps bootstrap now travels as -EncodedCommand:
#                 the bare "-Command iex(...)" form was re-parsed when the remote
#                 sshd DefaultShell was PowerShell (outer shell evaluated the
#                 subexpression itself and re-quoted the payload — silently
#                 corrupting $-bearing statements; verified against a pwsh-shell
#                 host). Encoded form is inert under cmd, PowerShell, and POSIX
#                 shells alike. Also: host tokens may not start with '-' (would
#                 parse as an ssh option), dry-run %q-quotes every ssh argv
#                 element (a metachar ProxyJump arg printed unquoted before).
#   v2.3 2026-08-10 payload text is NEVER modified: the ProgressPreference
#                 prefix broke payloads starting with param()/using (must be a
#                 script's first statements). Payloads now ride as untouched
#                 UTF-8 base64 inside a fixed wrapper that sets the preference
#                 and runs the decoded source as its own scriptblock. Sources
#                 are also encoded straight from the file/stdin (a $(cat)
#                 capture stripped trailing newlines — byte-for-byte now).
#   v2.3.1 2026-08-10 exit-code fix: v2.3's `& ([scriptblock]::Create(...))`
#                 masked payload failures — a failing remote ps command exited
#                 0, so callers/tests couldn't detect it (errors were still
#                 loud on stderr, but the status lied). The wrapper now appends
#                 `if (-not $?) { exit 1 }` INSIDE the scriptblock, where $?
#                 still reflects the payload's last statement, reproducing a
#                 bare `powershell -Command` exit code exactly (verified across
#                 PowerShell 5.1 and pwsh 7). Real-host verification surfaced a
#                 PRE-EXISTING Windows-sshd streamed-session race (A/B-confirmed
#                 version-independent) — documented in the caveats above.
#   v2.3.2 2026-08-10 encoding fix (external review): ps payload bytes were
#                 unconditionally decoded as UTF-8 remotely, so a UTF-16LE .ps1
#                 (Windows PowerShell's own Out-File/> default) transported
#                 byte-perfectly and then parsed as garbage. Both wrappers now
#                 decode through a BOM-detecting StreamReader (UTF-8/16/32 BOMs
#                 honored; BOM-less = UTF-8, the documented contract).
#   v2.3.3 2026-08-10 status honesty for the POSIX transport (external review):
#                 (a) `echo b64 | base64 -d | shell` reported the SHELL's
#                 status, so a broken/missing remote base64 meant EOF into the
#                 shell -> exit 0 with the payload NEVER RUN; decode is now a
#                 status-checked two-step (exit 125 on decode failure) and the
#                 payload's own exit code is what rrun returns. (b) streamed
#                 sends judged by PIPESTATUS[1] (ssh) — local printf SIGPIPE
#                 (141) after an early remote exit is not a failure.
#   v2.3.4 2026-08-10 execution is byte-for-byte again: v2.3.3's s=$(...)
#                 decode stripped trailing newlines AT EXECUTION (a payload
#                 ending in backslash-newline changed behavior) — the same
#                 class v2.3.0 fixed on the sender side, recreated on the
#                 receiver. Embedded bash/sh decode is now file-backed (like
#                 streaming), keeping exact bytes + honest decoder status +
#                 real stdin. Also: no exit code is reserved — transparency;
#                 the stderr marker identifies transport decode failures.
#   v2.3.5 2026-08-10 tempfile lifecycle: cleanup traps (EXIT + HUP/INT/TERM)
#                 so an interrupted wrapper never leaves the decoded payload
#                 (possibly containing secrets) behind on the target. Final
#                 bash/sh targets need mktemp+rm (documented).
#   v2.3.6 2026-08-10 hostspec structure validated before splitting: empty
#                 host crashed under set -u (unbound ${hops[0]}) instead of a
#                 clean exit 2, and a trailing comma ("h1,") was silently
#                 accepted because read -a drops trailing empty fields.
#   v2.3.7 2026-08-10 NESTED STREAMING: streaming was single-hop only, so a
#                 nested chain embedded the payload and re-armored it 4/3 per
#                 layer — a ~74KB script at 2 hops hit the LOCAL 128KiB E2BIG
#                 ceiling and leaked "Argument list too long" (verified on a
#                 real 2-hop chain). Since each intermediate ssh forwards its
#                 stdin onward, the streaming bootstrap now works at any hop
#                 count; rrun composes both forms and picks by measuring the
#                 finished OUTERMOST command. Also: RRUN_STREAM_LIMIT must be
#                 numeric (arithmetic contexts evaluate contents), and an
#                 explicitly empty -c is a valid no-op program (was rejected
#                 by the core/bash shim, accepted by the ps shim).
#   v2.3.8 2026-08-10 DOCS + COVERAGE, no behavior change (review round 9):
#                 (a) v2.3.7's README weakened the intermediate-hop requirement
#                 to "a POSIX shell" — the hop layer still runs `exec bash -c`,
#                 so bash is required BY NAME on every intermediate; understating
#                 a dependency sends debuggers down the wrong path. (b) Nested
#                 streaming's threshold counts COMMAND chars (not payload bytes)
#                 on the OUTERMOST layer, so the payload size that costs a
#                 payload its stdin is far smaller than RRUN_STREAM_LIMIT reads
#                 and shrinks per hop — measured per shell/hop-count in the
#                 caveats above, with -n named as the way to see which
#                 transport was chosen.
#                 (c) RRUN_MAX_CMD had no regression test (one loop validates
#                 both knobs and picks the name to report — each needs its own
#                 case), and negative values were untested.
#   v2.4  2026-08-10 PORTABILITY, found by the docker environment matrix
#                 (tests/matrix): (a) macOS/BSD senders died at `base64 -w0`
#                 ("invalid option -- w" — GNU-only flag, confirmed by the
#                 macos-sim cell); encoding now goes through b64enc(), which
#                 probes once and falls back to `base64 | tr -d '\n'`.
#                 (b) the hop layer ran `exec bash -c`, requiring bash BY NAME
#                 on every chain host after the first — including the FINAL
#                 host of a chain (the layer executes on hosts 2..N; the first
#                 hop only parses `ssh next '<quoted>'`, which even csh
#                 handles). The decoded text is always rrun's own POSIX
#                 one-liner, so it now runs `exec sh -c`: busybox/dash-only
#                 hosts are legal anywhere in a chain, and requirements are
#                 uniform — hosts 2..N need a POSIX login shell + base64 + sh.
#   v2.5  2026-08-11 ADB TRANSPORT (`adb` / `adb:<serial>` as the final hop).
#                 Class fix per the RSI rule: `adb shell` is a second boundary
#                 where a hand-quoted payload gets eaten, found when a
#                 `find ... \( -iname ... \)` sent from Git Bash arrived at the
#                 device with its escapes stripped and silently matched nothing
#                 (exit 0, empty output — the worst failure shape). adb is a
#                 near-exact structural match for ssh: argv is joined and parsed
#                 by the device's sh, stdin is forwarded, and the payload's exit
#                 code passes through — so the POSIX branch is reused verbatim
#                 and ONLY the delivery program changes. Android specifics are
#                 baked in rather than left to callers: (a) default -s is sh (no
#                 bash on stock Android) and -s ps is rejected with a real
#                 message; (b) the device command is prefixed
#                 TMPDIR=${TMPDIR:-/data/local/tmp} — mktemp is the FIRST thing
#                 the POSIX wrapper runs, and a device that leaves TMPDIR unset
#                 defaults it to /tmp, which does not exist on Android (mktemp
#                 fails -> exit 125, payload never runs); (c) when adb is the
#                 tail of an ssh chain the adb command is armored like any hop
#                 layer (`s=$(echo b64 | base64 -d)`) instead of nested-quoted,
#                 so the device command's own single quotes never meet the ssh
#                 layer's.
#   v2.9  2026-08-19 WSL TARGET SHELL (-s wsl): bash inside WSL on a Windows
#                 remote. Class fix per the RSI rule: `rrun -s bash <winhost>`
#                 tried to exec sh/bash ON THE WINDOWS SIDE ("The term 'sh' is
#                 not recognized...") — there was no way to reach a Windows
#                 host's WSL without hand-quoting ssh→PowerShell→wsl.exe, the
#                 exact boundary stack this tool exists to remove. The Windows
#                 side is crossed exactly like -s ps (a fixed PowerShell
#                 bootstrap rides as -EncodedCommand, inert under cmd/
#                 PowerShell/POSIX gateways); the bootstrap base64-decodes
#                 rrun's usual POSIX tempfile wrapper into $__c and hands it to
#                 `wsl.exe -e sh -c $__c` as ONE native argument (plain
#                 balanced quotes only — nothing with \" may cross a PowerShell
#                 native-argument boundary, the ps-shim v1.12 lesson), so
#                 quoting still never stacks; bash runs the payload inside WSL.
#                 Streamed form pipes [Console]::In.ReadToEnd() into wsl.exe
#                 (the PowerShell pipe appends CRLF, so the wrapper strips \r
#                 ahead of base64 -d). Missing wsl.exe on the target exits 125
#                 with a loud stderr marker. Rejected for adb targets (Android
#                 has no WSL); multi-hop and -J compose exactly as -s ps does.
set -euo pipefail

# GNU base64 takes -w0; BSD/macOS base64 has no -w AT ALL (a macOS sender
# died with "invalid option -- w"). Probe by execution, choose once.
if printf x | base64 -w0 >/dev/null 2>&1; then
  b64enc() { base64 -w0; }
else
  b64enc() { base64 | tr -d '\n'; }
fi

shell="" jump="" dry=0
while getopts ":s:J:n" opt; do
  case $opt in
    s) shell=$OPTARG ;;
    J) jump=$OPTARG ;;
    n) dry=1 ;;
    :) echo "rrun: option -$OPTARG requires an argument" >&2; exit 2 ;;
    *) echo "rrun: unknown option -${OPTARG:-}" >&2; exit 2 ;;
  esac
done
shift $((OPTIND-1))

if (( $# < 2 )); then
  echo 'usage: rrun [-s ps|bash|sh|wsl] [-J jumps] [-n] <host[,host2,...]|adb[:serial]> <script | - | -c "cmds">' >&2
  exit 2
fi

hostspec=$1; shift
src=$1
# Encode the source STRAIGHT into base64 — capturing file/stdin contents in a
# shell variable first would strip trailing newlines (command substitution
# deletes them), breaking byte-for-byte payload preservation.
case "$src" in
  # ${2?...} not ${2:?...}: an EXPLICITLY EMPTY command is a valid (no-op)
  # program and must run like one — only a MISSING argument is an error. The
  # shims accept empty too; rrun adds no semantics of its own.
  -c) payload_b64=$(printf %s "${2?rrun: -c needs a command string}" | b64enc) ;;
  -)  payload_b64=$(b64enc) ;;
  *)  payload_b64=$(b64enc < "$src") ;;
esac

# An Android device is reached with `adb [-s serial] shell <cmd>`, not ssh. Detect
# it from the LAST hostspec component (adb can only ever be the final target —
# nothing ssh's *out* of a device shell in this design) so shell defaulting below
# can account for it before anything else is decided.
adb_target=0 adb_serial=""
case "${hostspec##*,}" in
  adb)   adb_target=1 ;;
  adb:*) adb_target=1; adb_serial=${hostspec##*,}; adb_serial=${adb_serial#adb:} ;;
esac
if (( adb_target )) && [[ -n $adb_serial && ! $adb_serial =~ ^[A-Za-z0-9._:-]+$ ]]; then
  # The serial is the one adb argument rrun interpolates, so it must be inert.
  echo "rrun: invalid adb serial '$adb_serial' (allowed: letters, digits, . _ : -)" >&2
  exit 2
fi

if [[ -z $shell ]]; then
  case "$src" in
    *.sh|*.bash) shell=bash ;;
    # Stock Android has no PowerShell and no bash — only /system/bin/sh. Defaulting
    # an adb target to ps (the ssh default) would fail on every device.
    *)           if (( adb_target )); then shell=sh; else shell=ps; fi ;;
  esac
fi

case "$shell" in
  ps|bash|sh|wsl) ;;
  *) echo "rrun: -s must be ps, bash, sh or wsl (got '$shell')" >&2; exit 2 ;;
esac

if (( adb_target )) && [[ $shell == ps || $shell == wsl ]]; then
  echo "rrun: -s $shell is not valid for an adb target (Android has neither PowerShell nor WSL); use -s sh" >&2
  exit 2
fi
if (( adb_target )) && [[ -n $jump ]]; then
  # ProxyJump is an ssh concept; the adb client speaks USB/TCP to the device.
  echo 'rrun: -J is meaningless for an adb target' >&2
  exit 2
fi

# Structural validation BEFORE splitting: `read -a` silently discards a
# trailing empty field (so "h1," passed as just h1), and an empty hostspec
# produced a zero-element array that later crashed on ${hops[0]} under set -u
# instead of exiting 2 with a real message.
if [[ ! $hostspec =~ ^[^,]+(,[^,]+)*$ ]]; then
  echo "rrun: invalid host spec '$hostspec' (need host[,hop2,...], no empty components)" >&2
  exit 2
fi
IFS=, read -ra hops <<<"$hostspec"
# Hop tokens are the ONE thing interpolated into intermediate shell commands
# (the payload itself is always armored) — so they must be plain host tokens.
# A leading '-' is rejected separately: ssh would parse it as an option, not a
# destination.
for h in "${hops[@]}"; do
  if [[ $h == -* || ! $h =~ ^[A-Za-z0-9._@:-]+$ ]]; then
    echo "rrun: invalid host token '$h' (allowed: letters, digits, . _ @ : -; no leading -)" >&2
    exit 2
  fi
done
# An adb token anywhere but the end would mean "ssh onward FROM the device",
# which this transport does not provide. Catch it here with a real message
# instead of trying to ssh to a host literally named "adb".
for ((i=0; i<${#hops[@]}-1; i++)); do
  if [[ ${hops[i]} == adb || ${hops[i]} == adb:* ]]; then
    echo "rrun: 'adb' is only valid as the LAST hop (got '$hostspec')" >&2
    exit 2
  fi
done
# The device is not an ssh destination, so it must not drive an ssh layer. What
# remains in `hops` are the real ssh hosts; an empty array means the adb client
# runs right here.
if (( adb_target )); then
  unset 'hops[${#hops[@]}-1]'
  hops=("${hops[@]}")
fi

# The composed command can blow past a command-line limit — 8191 chars via
# cmd.exe on stock Windows OpenSSH, 128 KiB per argv element on Linux (E2BIG,
# hit LOCALLY at exec time). Nested hops make that worse: every layer re-armors
# the whole thing, so an embedded payload grows 4/3 per hop.
#
# So the payload can travel two ways, and rrun picks by measuring the finished
# OUTERMOST command rather than guessing:
#   embedded  — payload base64 rides inside the command string (small payloads)
#   streamed  — payload base64 rides on stdin behind a small fixed bootstrap
# Streaming works at ANY hop count: each intermediate ssh inherits its parent's
# stdin and forwards it to the next hop, so only the innermost bootstrap
# consumes it, and the nested command stays tiny no matter how big the payload.
#
# The ps bootstrap rides as -EncodedCommand: the remote sshd's shell may be cmd
# OR PowerShell (DefaultShell), and a bare "-Command iex(...)" form gets
# re-parsed by an outer PowerShell (it evaluates the parenthesized subexpression
# itself, then re-quotes the payload through a second -Command layer — silently
# corrupting $-bearing statements). Base64 is inert in every shell; that's the
# whole point of this tool.
# RRUN_STREAM_LIMIT is the embed->stream THRESHOLD (not a ceiling): crossing it
# just switches transports. RRUN_MAX_CMD is the hard ceiling — the point where
# even the streamed form cannot be delivered, so rrun must fail with advice
# instead of leaking E2BIG. Default 100000 keeps clear of the 128 KiB
# (MAX_ARG_STRLEN) per-argv-element limit measured on Linux.
limit=${RRUN_STREAM_LIMIT:-6000}
maxcmd=${RRUN_MAX_CMD:-100000}
# Arithmetic contexts recursively evaluate variable contents, so a non-numeric
# value becomes a confusing arithmetic/unbound error instead of a diagnostic.
for v in limit maxcmd; do
  if [[ ! ${!v} =~ ^[0-9]+$ ]]; then
    n=RRUN_STREAM_LIMIT; [[ $v == maxcmd ]] && n=RRUN_MAX_CMD
    echo "rrun: $n must be a non-negative integer (got '${!v}')" >&2
    exit 2
  fi
done

if [[ $shell == ps ]]; then
  # The payload text is never touched: prepending a statement broke param()/
  # using payloads (they must be a script's FIRST statements). Instead a fixed
  # wrapper sets ProgressPreference (else EncodedCommand with redirected stderr
  # spews "#< CLIXML ... Preparing modules" progress records) and runs the
  # decoded source as its own scriptblock, preserving its lexical start.
  # The epilogue ("if (-not $?) { exit 1 }") is appended INSIDE the scriptblock
  # — where $? still reflects the payload's last statement — so a failing
  # payload exits non-zero just like a bare `powershell -Command` would. The &
  # operator otherwise masks the failure and rrun would exit 0 on a broken
  # remote command, hiding errors from callers. [char]10 separates it from the
  # payload's final line (a trailing comment would otherwise swallow it).
  # Bytes -> text via a BOM-detecting StreamReader, NOT a hardcoded UTF-8
  # decode: PowerShell 5.1 tooling routinely writes UTF-16LE .ps1 files
  # (Out-File / > default), which a blind UTF-8 decode turns into garbage.
  # BOM-less sources are decoded as UTF-8 (the documented contract).
  ps_wrapper="\$ProgressPreference='SilentlyContinue'; \$__rb=[Convert]::FromBase64String('$payload_b64'); & ([scriptblock]::Create((New-Object IO.StreamReader((New-Object IO.MemoryStream(,\$__rb)),\$true)).ReadToEnd() + [char]10 + 'if (-not \$?) { exit 1 }'))"
  ps_embed_b64=$(printf %s "$ps_wrapper" | iconv -f UTF-8 -t UTF-16LE | b64enc)
  # same wrapper, reading the payload base64 from stdin instead
  ps_boot="\$ProgressPreference='SilentlyContinue'; \$__rb=[Convert]::FromBase64String([Console]::In.ReadToEnd()); & ([scriptblock]::Create((New-Object IO.StreamReader((New-Object IO.MemoryStream(,\$__rb)),\$true)).ReadToEnd() + [char]10 + 'if (-not \$?) { exit 1 }'))"
  ps_stream_b64=$(printf %s "$ps_boot" | iconv -f UTF-8 -t UTF-16LE | b64enc)
fi

if [[ $shell == wsl ]]; then
  # -s wsl: the payload runs under bash INSIDE WSL on a Windows target. Two
  # boundaries are crossed, each with the armoring it already trusts:
  #   Windows side — a fixed PowerShell bootstrap rides as -EncodedCommand,
  #     inert under cmd.exe, PowerShell, and POSIX gateways alike (same
  #     delivery shape as -s ps), so the remote sshd's DefaultShell never
  #     parses anything of the payload's.
  #   WSL side — the bootstrap base64-decodes rrun's usual POSIX tempfile
  #     wrapper into $__c and hands it to `wsl.exe -e sh -c $__c` as ONE
  #     native argument. The wrapper carries plain balanced quotes only:
  #     nothing with \"-escaped quotes may cross a PowerShell native-argument
  #     boundary (5.1 mangles them — the ps-shim v1.12 lesson), which is why
  #     the trap body is single-quoted here, unlike the ssh POSIX branch in
  #     build_inner whose whole wrapper sits inside outer single quotes.
  # wsl.exe absent (no WSL on the target) is a transport failure: loud stderr
  # marker + exit 125, never a silent success (Get-Command probe — exit
  # $LASTEXITCODE after a throw would otherwise exit 0). The payload's own
  # exit code passes back via $LASTEXITCODE; a PowerShell sshd gateway still
  # flattens non-zero to 1, the same documented caveat as -s ps.
  wsl_pre="t=\$(mktemp) || exit 125; trap 'rm -f \"\$t\"' 0; trap exit 1 2 15;"
  wsl_post="|| { echo rrun: remote decode failed >&2; exit 125; }; bash \"\$t\""
  wsl_guard="if (-not (Get-Command wsl.exe -ErrorAction SilentlyContinue)) { [Console]::Error.WriteLine('rrun: wsl.exe not found on target'); exit 125 }; "
  wb=$(printf %s "$wsl_pre echo $payload_b64 | base64 -d > \"\$t\" $wsl_post" | b64enc)
  wsl_boot="\$ProgressPreference='SilentlyContinue'; $wsl_guard\$__c=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('$wb')); & wsl.exe -e sh -c \$__c; exit \$LASTEXITCODE"
  wsl_embed_b64=$(printf %s "$wsl_boot" | iconv -f UTF-8 -t UTF-16LE | b64enc)
  # streamed: the bootstrap reads the payload base64 off the ssh channel itself
  # and pipes it into wsl.exe — explicit, not inherited-handle, so it behaves
  # the same under both PowerShell editions. The pipe-to-native appends a CRLF
  # (and 5.1 re-encodes via $OutputEncoding — harmless, base64 is ASCII), and
  # GNU base64 -d rejects a bare \r as garbage, so the wrapper strips it first.
  wb=$(printf %s "$wsl_pre tr -d '\\r' | base64 -d > \"\$t\" $wsl_post" | b64enc)
  wsl_boot="\$ProgressPreference='SilentlyContinue'; $wsl_guard\$__c=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('$wb')); [Console]::In.ReadToEnd() | & wsl.exe -e sh -c \$__c; exit \$LASTEXITCODE"
  wsl_stream_b64=$(printf %s "$wsl_boot" | iconv -f UTF-8 -t UTF-16LE | b64enc)
fi

tmpfix=""
if (( adb_target )); then tmpfix="TMPDIR=\${TMPDIR:-/data/local/tmp}; "; fi

# build_inner is split out of compose() because the adb transport needs this
# string BY ITSELF in the parent shell (it becomes a single argv element for the
# local adb client). compose() runs inside a command substitution, so anything it
# assigned to a global would be discarded with the subshell — a mistake that
# costs nothing here and is silent everywhere else.
build_inner() {  # $1: 0 = payload embedded in the command, 1 = payload on stdin
                 # -> the command that runs ON the final target
  local st=$1 c
  case "$shell" in
    ps)
      if (( st )); then c="powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand $ps_stream_b64"
      else              c="powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand $ps_embed_b64"
      fi
      ;;
    wsl)
      # same delivery shape as ps — a base64-armored -EncodedCommand bootstrap
      # no gateway shell can re-parse; the bootstrap itself carries the payload
      # into WSL (see the wsl_boot construction above), so multi-hop chains and
      # -J compose here exactly as they do for ps.
      if (( st )); then c="powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand $wsl_stream_b64"
      else              c="powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand $wsl_embed_b64"
      fi
      ;;
    *)
      # File-backed decode -> run, NOT `echo b64 | base64 -d | shell`: without
      # pipefail (unavailable in a POSIX login shell) that pipeline reports the
      # SHELL's status, so a missing/broken remote base64 fed EOF to the shell
      # and rrun exited 0 while the payload NEVER RAN. And NOT
      # `s=$(...); shell -c "$s"`: command substitution strips trailing
      # newlines, silently changing payloads that end in backslash-newline —
      # execution must be byte-for-byte, like the transport. A temp file gives
      # all three at once: exact bytes, an honest decoder status, and (when
      # embedded) the payload keeping the REAL stdin. The `sh -c '...'` outer
      # wrap keeps the one-liner parseable even when the remote login shell is
      # csh/fish. The payload's own exit code passes through untouched — rrun
      # reserves nothing; its own decode failure exits 125 AND prints the
      # stderr marker, which is what identifies it as transport-level. Traps
      # clean the decoded file up on normal exit and on catchable HUP/INT/TERM
      # (SIGKILL and host crashes can't be trapped); the EXIT trap does not
      # alter the exit status, so the executor's code passes through.
      # mktemp is the FIRST thing this wrapper runs, so its default directory is
      # a hard dependency. Android leaves /tmp nonexistent; a device that also
      # leaves TMPDIR unset would fail mktemp and exit 125 with the payload never
      # run. Pinning the default here (not overriding a TMPDIR the device DID
      # set) makes the wrapper's own precondition true on every device.
      if (( st )); then
        c="sh -c '${tmpfix}t=\$(mktemp) || exit 125; trap \"rm -f \\\"\$t\\\"\" 0; trap exit 1 2 15; base64 -d > \"\$t\" || { echo rrun: remote decode failed >&2; exit 125; }; $shell \"\$t\"'"
      else
        c="sh -c '${tmpfix}t=\$(mktemp) || exit 125; trap \"rm -f \\\"\$t\\\"\" 0; trap exit 1 2 15; echo $payload_b64 | base64 -d > \"\$t\" || { echo rrun: remote decode failed >&2; exit 125; }; $shell \"\$t\"'"
      fi
      ;;
  esac
  printf %s "$c"
}

compose() {  # $1: 0 = payload embedded in the command, 1 = payload on stdin
             # -> the OUTERMOST command (what rrun itself executes)
  local st=$1 c b i
  c=$(build_inner "$st")

  # adb delivery. The device command becomes the argument of `adb shell`, which
  # joins its argv and hands the result to /system/bin/sh — structurally the same
  # contract as ssh, so nothing above needed to change. Two forms:
  #   * no ssh hops left  -> the caller executes build_inner's output as ONE argv
  #     element (no shell in between at all, so nothing can re-parse it).
  #   * adb after a chain -> the adb invocation must ride INSIDE an ssh layer, so
  #     it is armored exactly like a hop layer. Nesting the device command's own
  #     single quotes inside the ssh layer's would be the very quote-stacking
  #     this tool exists to prevent.
  if (( adb_target )); then
    b=$(printf %s "$c" | b64enc)
    c="s=\$(echo $b | base64 -d) || { echo rrun: adb decode failed >&2; exit 125; }; exec adb${adb_serial:+ -s $adb_serial} shell \"\$s\""
  fi
  # Wrap outward from the final hop: each intermediate host runs
  #   ssh <next> '<armored inner command>'
  # where the quoted part is pure base64 — no hop ever parses a metacharacter
  # originating from an inner layer, so quoting never stacks. The hop layer
  # keeps the status-honest $(...) form (no single quotes inside — the layer
  # itself is single-quoted); trailing-newline stripping is harmless HERE
  # because the decoded text is rrun's own generated one-line ssh command,
  # never user payload bytes. `exec` keeps stdin attached to the next ssh, so
  # a streamed payload flows through the whole chain. Hop login shells must be
  # POSIX-capable.
  # `exec sh -c`, NOT `exec bash -c`: the decoded text is rrun's own generated
  # one-liner (another hop layer or the final sh -c/powershell wrapper), always
  # POSIX — requiring bash here made busybox/dash-only hosts illegal anywhere
  # after the first chain position, for no benefit (matrix-confirmed).
  for ((i=${#hops[@]}-2; i>=0; i--)); do
    b=$(printf %s "$c" | b64enc)
    c="ssh -o BatchMode=yes ${hops[i+1]} 's=\$(echo $b | base64 -d) || { echo rrun: hop decode failed >&2; exit 125; }; exec sh -c \"\$s\"'"
  done
  printf %s "$c"
}

cmd=$(compose 0)
stream=0
if (( ${#cmd} > limit )); then
  stream=1
  cmd=$(compose 1)
  b64=$payload_b64
fi

# Backstop: even the streamed form is per-hop re-armored, so a very deep chain
# can still outgrow what execve will accept. Fail with advice rather than
# leaking "Argument list too long" from the exec itself.
if (( ${#cmd} > maxcmd )); then
  echo "rrun: composed command is ${#cmd} chars, over the ${maxcmd} limit (${#hops[@]} hops); use -J <hops> instead — ProxyJump is a single connection" >&2
  exit 2
fi

sshopts=(-o BatchMode=yes)
if [[ -n $jump ]]; then
  sshopts+=(-J "$jump")
fi

# The delivery argv, built once and used by both the dry-run and the real run so
# the two can never drift. An adb target with no ssh hops left is delivered by
# the local adb client: the device command goes as ONE argv element, so no shell
# stands between rrun and adb and there is nothing left to re-parse it.
if (( adb_target )) && (( ${#hops[@]} == 0 )); then
  deliver=(adb)
  [[ -n $adb_serial ]] && deliver+=(-s "$adb_serial")
  # Rebuilt in THIS shell (not captured from compose, which runs in a subshell)
  # and for the transport actually chosen, so the embedded/streamed forms cannot
  # disagree with the `stream` flag the caller acts on.
  deliver+=(shell "$(build_inner "$stream")")
else
  deliver=(ssh "${sshopts[@]}" "${hops[0]}" "$cmd")
fi

if (( dry )); then
  # %q on EVERY argv element makes the printed command paste-safe: the composed
  # remote command ("| base64 -d | bash") would otherwise execute LOCALLY when
  # pasted, and a metacharacter-bearing -J argument would do the same.
  dryout=$(printf '%q ' "${deliver[@]}")
  if (( stream )); then
    printf 'printf %%s %s | %s\n' "$b64" "${dryout% }"
  else
    printf '%s\n' "${dryout% }"
  fi
  exit 0
fi

if (( stream )); then
  # Judge success by the TRANSPORT element alone. If a big streamed script exits
  # before reading all of stdin, the channel closes while printf still has
  # data: printf dies with SIGPIPE (141) and pipefail would report that even
  # though the REMOTE COMMAND SUCCEEDED. PIPESTATUS[1] is the transport's own
  # status (the remote exit code, or 255 for ssh transport errors). adb forwards
  # stdin to the device and passes the payload's exit code back the same way.
  set +e +o pipefail
  printf %s "$b64" | "${deliver[@]}"
  exit "${PIPESTATUS[1]}"
fi
exec "${deliver[@]}"

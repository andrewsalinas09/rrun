#!/usr/bin/env bash
# rrun — run a payload on a remote host with ZERO escaping.
# The payload never rides inside quoted shell strings: it travels as base64
# ([A-Za-z0-9+/=] is inert in every shell) and is decoded only by the shell
# that will execute it. For multi-hop chains, each intermediate ssh command is
# itself re-armored, so quoting depth stays flat no matter how many hops.
#
# usage: rrun [-s ps|bash|sh] [-J jumphosts] [-n] <host[,host2,...]> <script | - | -c "cmds">
#   -s ps|bash|sh  target shell on the FINAL host (default ps; *.sh/*.bash files -> bash)
#   -J jumphosts   ssh ProxyJump — preferred for hops when local can auth to the final host
#   -n             dry-run: print the composed invocation (shell-quoted, paste-safe)
#   host,host2     nested-hop chain (use when intermediate hosts hold the keys);
#                  intermediate hops need base64 + bash; payload runs on the LAST host.
#
# caveats:
#   * STREAMED bash/sh payloads cannot read stdin (the channel carries the
#     payload). Non-streamed bash/sh payloads read the real ssh channel as of
#     v2.3.3 (they used to read their own script text from the decode pipe).
#   * payload exit codes pass through UNTOUCHED — rrun reserves nothing. A
#     transport-level decode failure exits 125 AND prints "rrun: ... decode
#     failed" on stderr; the stderr marker (not the number) identifies it.
#   * large payloads (composed command > RRUN_STREAM_LIMIT, default 6000 chars —
#     sized for the 8191-char cmd.exe limit on stock Windows OpenSSH targets)
#     auto-switch to streaming the base64 over stdin; the remote payload then
#     cannot read stdin. Streaming works at ANY hop count (each intermediate
#     ssh forwards stdin to the next), so nested chains carry big payloads too.
#   * KNOWN ISSUE: streamed sessions to a Windows sshd can nondeterministically
#     wedge remotely before the payload runs (host-side sshd/DefaultShell race,
#     independent of rrun version and payload — see README caveats). Wrap in a
#     timeout + retry, or raise RRUN_STREAM_LIMIT on pwsh-DefaultShell hosts.
#
# history:
#   v1            PowerShell -EncodedCommand only, single hop.
#   v2   2026-08-10 bash/sh targets, comma multi-hop with per-layer re-armoring,
#                 -J, -n, extension autodetect. Class fix per RSI rule.
#   v2.1 2026-08-10 ps payloads get $ProgressPreference prepended (CLIXML noise).
#   v2.2 2026-08-10 external review fixes: stdin-streaming transport for large
#                 payloads (Windows 8191-char command-line ceiling), %q paste-safe
#                 dry-run, host-token validation, -s validation, missing-optarg
#                 errors, cat --, size guard on multi-hop ps targets.
#   v2.3 2026-08-10 payload text is NEVER modified: the ProgressPreference
#                 prefix broke payloads starting with param()/using (must be a
#                 script's first statements). Payloads now ride as untouched
#                 UTF-8 base64 inside a fixed wrapper that sets the preference
#                 and runs the decoded source as its own scriptblock. Sources
#                 are also encoded straight from the file/stdin (a $(cat)
#                 capture stripped trailing newlines — byte-for-byte now).
#   v2.3.1 2026-08-10 exit-code fix: v2.3's `& ([scriptblock]::Create(...))`
#                 masked payload failures — a failing remote ps command exited
#                 0, so callers/tests couldn't detect it (errors were still
#                 loud on stderr, but the status lied). The wrapper now appends
#                 `if (-not $?) { exit 1 }` INSIDE the scriptblock, where $?
#                 still reflects the payload's last statement, reproducing a
#                 bare `powershell -Command` exit code exactly (verified across
#                 PowerShell 5.1 and pwsh 7). Real-host verification surfaced a
#                 PRE-EXISTING Windows-sshd streamed-session race (A/B-confirmed
#                 version-independent) — documented in the caveats above.
#   v2.3.2 2026-08-10 encoding fix (external review): ps payload bytes were
#                 unconditionally decoded as UTF-8 remotely, so a UTF-16LE .ps1
#                 (Windows PowerShell's own Out-File/> default) transported
#                 byte-perfectly and then parsed as garbage. Both wrappers now
#                 decode through a BOM-detecting StreamReader (UTF-8/16/32 BOMs
#                 honored; BOM-less = UTF-8, the documented contract).
#   v2.3.3 2026-08-10 status honesty for the POSIX transport (external review):
#                 (a) `echo b64 | base64 -d | shell` reported the SHELL's
#                 status, so a broken/missing remote base64 meant EOF into the
#                 shell -> exit 0 with the payload NEVER RUN; decode is now a
#                 status-checked two-step (exit 125 on decode failure) and the
#                 payload's own exit code is what rrun returns. (b) streamed
#                 sends judged by PIPESTATUS[1] (ssh) — local printf SIGPIPE
#                 (141) after an early remote exit is not a failure.
#   v2.3.4 2026-08-10 execution is byte-for-byte again: v2.3.3's s=$(...)
#                 decode stripped trailing newlines AT EXECUTION (a payload
#                 ending in backslash-newline changed behavior) — the same
#                 class v2.3.0 fixed on the sender side, recreated on the
#                 receiver. Embedded bash/sh decode is now file-backed (like
#                 streaming), keeping exact bytes + honest decoder status +
#                 real stdin. Also: no exit code is reserved — transparency;
#                 the stderr marker identifies transport decode failures.
#   v2.3.5 2026-08-10 tempfile lifecycle: cleanup traps (EXIT + HUP/INT/TERM)
#                 so an interrupted wrapper never leaves the decoded payload
#                 (possibly containing secrets) behind on the target. Final
#                 bash/sh targets need mktemp+rm (documented).
#   v2.3.6 2026-08-10 hostspec structure validated before splitting: empty
#                 host crashed under set -u (unbound ${hops[0]}) instead of a
#                 clean exit 2, and a trailing comma ("h1,") was silently
#                 accepted because read -a drops trailing empty fields.
#   v2.3.7 2026-08-10 NESTED STREAMING: streaming was single-hop only, so a
#                 nested chain embedded the payload and re-armored it 4/3 per
#                 layer — a ~74KB script at 2 hops hit the LOCAL 128KiB E2BIG
#                 ceiling and leaked "Argument list too long" (verified on a
#                 real 2-hop chain). Since each intermediate ssh forwards its
#                 stdin onward, the streaming bootstrap now works at any hop
#                 count; rrun composes both forms and picks by measuring the
#                 finished OUTERMOST command. Also: RRUN_STREAM_LIMIT must be
#                 numeric (arithmetic contexts evaluate contents), and an
#                 explicitly empty -c is a valid no-op program (was rejected
#                 by the core/bash shim, accepted by the ps shim).
#   v2.2.1 2026-08-10 streaming ps bootstrap now travels as -EncodedCommand:
#                 the bare "-Command iex(...)" form was re-parsed when the remote
#                 sshd DefaultShell was PowerShell (outer shell evaluated the
#                 subexpression itself and re-quoted the payload — silently
#                 corrupting $-bearing statements; verified against a pwsh-shell
#                 host). Encoded form is inert under cmd, PowerShell, and POSIX
#                 shells alike. Also: host tokens may not start with '-' (would
#                 parse as an ssh option), dry-run %q-quotes every ssh argv
#                 element (a metachar ProxyJump arg printed unquoted before).
set -euo pipefail

shell="" jump="" dry=0
while getopts ":s:J:n" opt; do
  case $opt in
    s) shell=$OPTARG ;;
    J) jump=$OPTARG ;;
    n) dry=1 ;;
    :) echo "rrun: option -$OPTARG requires an argument" >&2; exit 2 ;;
    *) echo "rrun: unknown option -${OPTARG:-}" >&2; exit 2 ;;
  esac
done
shift $((OPTIND-1))

if (( $# < 2 )); then
  echo 'usage: rrun [-s ps|bash|sh] [-J jumps] [-n] <host[,host2,...]> <script | - | -c "cmds">' >&2
  exit 2
fi

hostspec=$1; shift
src=$1
# Encode the source STRAIGHT into base64 — capturing file/stdin contents in a
# shell variable first would strip trailing newlines (command substitution
# deletes them), breaking byte-for-byte payload preservation.
case "$src" in
  # ${2?...} not ${2:?...}: an EXPLICITLY EMPTY command is a valid (no-op)
  # program and must run like one — only a MISSING argument is an error. The
  # shims accept empty too; rrun adds no semantics of its own.
  -c) payload_b64=$(printf %s "${2?rrun: -c needs a command string}" | base64 -w0) ;;
  -)  payload_b64=$(base64 -w0) ;;
  *)  payload_b64=$(base64 -w0 < "$src") ;;
esac

if [[ -z $shell ]]; then
  case "$src" in
    *.sh|*.bash) shell=bash ;;
    *)           shell=ps ;;
  esac
fi

case "$shell" in
  ps|bash|sh) ;;
  *) echo "rrun: -s must be ps, bash or sh (got '$shell')" >&2; exit 2 ;;
esac

# Structural validation BEFORE splitting: `read -a` silently discards a
# trailing empty field (so "h1," passed as just h1), and an empty hostspec
# produced a zero-element array that later crashed on ${hops[0]} under set -u
# instead of exiting 2 with a real message.
if [[ ! $hostspec =~ ^[^,]+(,[^,]+)*$ ]]; then
  echo "rrun: invalid host spec '$hostspec' (need host[,hop2,...], no empty components)" >&2
  exit 2
fi
IFS=, read -ra hops <<<"$hostspec"
# Hop tokens are the ONE thing interpolated into intermediate shell commands
# (the payload itself is always armored) — so they must be plain host tokens.
# A leading '-' is rejected separately: ssh would parse it as an option, not a
# destination.
for h in "${hops[@]}"; do
  if [[ $h == -* || ! $h =~ ^[A-Za-z0-9._@:-]+$ ]]; then
    echo "rrun: invalid host token '$h' (allowed: letters, digits, . _ @ : -; no leading -)" >&2
    exit 2
  fi
done

# The composed command can blow past a command-line limit — 8191 chars via
# cmd.exe on stock Windows OpenSSH, 128 KiB per argv element on Linux (E2BIG,
# hit LOCALLY at exec time). Nested hops make that worse: every layer re-armors
# the whole thing, so an embedded payload grows 4/3 per hop.
#
# So the payload can travel two ways, and rrun picks by measuring the finished
# OUTERMOST command rather than guessing:
#   embedded  — payload base64 rides inside the command string (small payloads)
#   streamed  — payload base64 rides on stdin behind a small fixed bootstrap
# Streaming works at ANY hop count: each intermediate ssh inherits its parent's
# stdin and forwards it to the next hop, so only the innermost bootstrap
# consumes it, and the nested command stays tiny no matter how big the payload.
#
# The ps bootstrap rides as -EncodedCommand: the remote sshd's shell may be cmd
# OR PowerShell (DefaultShell), and a bare "-Command iex(...)" form gets
# re-parsed by an outer PowerShell (it evaluates the parenthesized subexpression
# itself, then re-quotes the payload through a second -Command layer — silently
# corrupting $-bearing statements). Base64 is inert in every shell; that's the
# whole point of this tool.
# RRUN_STREAM_LIMIT is the embed->stream THRESHOLD (not a ceiling): crossing it
# just switches transports. RRUN_MAX_CMD is the hard ceiling — the point where
# even the streamed form cannot be delivered, so rrun must fail with advice
# instead of leaking E2BIG. Default 100000 keeps clear of the 128 KiB
# (MAX_ARG_STRLEN) per-argv-element limit measured on Linux.
limit=${RRUN_STREAM_LIMIT:-6000}
maxcmd=${RRUN_MAX_CMD:-100000}
# Arithmetic contexts recursively evaluate variable contents, so a non-numeric
# value becomes a confusing arithmetic/unbound error instead of a diagnostic.
for v in limit maxcmd; do
  if [[ ! ${!v} =~ ^[0-9]+$ ]]; then
    n=RRUN_STREAM_LIMIT; [[ $v == maxcmd ]] && n=RRUN_MAX_CMD
    echo "rrun: $n must be a non-negative integer (got '${!v}')" >&2
    exit 2
  fi
done

if [[ $shell == ps ]]; then
  # The payload text is never touched: prepending a statement broke param()/
  # using payloads (they must be a script's FIRST statements). Instead a fixed
  # wrapper sets ProgressPreference (else EncodedCommand with redirected stderr
  # spews "#< CLIXML ... Preparing modules" progress records) and runs the
  # decoded source as its own scriptblock, preserving its lexical start.
  # The epilogue ("if (-not $?) { exit 1 }") is appended INSIDE the scriptblock
  # — where $? still reflects the payload's last statement — so a failing
  # payload exits non-zero just like a bare `powershell -Command` would. The &
  # operator otherwise masks the failure and rrun would exit 0 on a broken
  # remote command, hiding errors from callers. [char]10 separates it from the
  # payload's final line (a trailing comment would otherwise swallow it).
  # Bytes -> text via a BOM-detecting StreamReader, NOT a hardcoded UTF-8
  # decode: PowerShell 5.1 tooling routinely writes UTF-16LE .ps1 files
  # (Out-File / > default), which a blind UTF-8 decode turns into garbage.
  # BOM-less sources are decoded as UTF-8 (the documented contract).
  ps_wrapper="\$ProgressPreference='SilentlyContinue'; \$__rb=[Convert]::FromBase64String('$payload_b64'); & ([scriptblock]::Create((New-Object IO.StreamReader((New-Object IO.MemoryStream(,\$__rb)),\$true)).ReadToEnd() + [char]10 + 'if (-not \$?) { exit 1 }'))"
  ps_embed_b64=$(printf %s "$ps_wrapper" | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
  # same wrapper, reading the payload base64 from stdin instead
  ps_boot="\$ProgressPreference='SilentlyContinue'; \$__rb=[Convert]::FromBase64String([Console]::In.ReadToEnd()); & ([scriptblock]::Create((New-Object IO.StreamReader((New-Object IO.MemoryStream(,\$__rb)),\$true)).ReadToEnd() + [char]10 + 'if (-not \$?) { exit 1 }'))"
  ps_stream_b64=$(printf %s "$ps_boot" | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
fi

compose() {  # $1: 0 = payload embedded in the command, 1 = payload on stdin
  local st=$1 c b i
  case "$shell" in
    ps)
      if (( st )); then c="powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand $ps_stream_b64"
      else              c="powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand $ps_embed_b64"
      fi
      ;;
    *)
      # File-backed decode -> run, NOT `echo b64 | base64 -d | shell`: without
      # pipefail (unavailable in a POSIX login shell) that pipeline reports the
      # SHELL's status, so a missing/broken remote base64 fed EOF to the shell
      # and rrun exited 0 while the payload NEVER RAN. And NOT
      # `s=$(...); shell -c "$s"`: command substitution strips trailing
      # newlines, silently changing payloads that end in backslash-newline —
      # execution must be byte-for-byte, like the transport. A temp file gives
      # all three at once: exact bytes, an honest decoder status, and (when
      # embedded) the payload keeping the REAL stdin. The `sh -c '...'` outer
      # wrap keeps the one-liner parseable even when the remote login shell is
      # csh/fish. The payload's own exit code passes through untouched — rrun
      # reserves nothing; its own decode failure exits 125 AND prints the
      # stderr marker, which is what identifies it as transport-level. Traps
      # clean the decoded file up on normal exit and on catchable HUP/INT/TERM
      # (SIGKILL and host crashes can't be trapped); the EXIT trap does not
      # alter the exit status, so the executor's code passes through.
      if (( st )); then
        c="sh -c 't=\$(mktemp) || exit 125; trap \"rm -f \\\"\$t\\\"\" 0; trap exit 1 2 15; base64 -d > \"\$t\" || { echo rrun: remote decode failed >&2; exit 125; }; $shell \"\$t\"'"
      else
        c="sh -c 't=\$(mktemp) || exit 125; trap \"rm -f \\\"\$t\\\"\" 0; trap exit 1 2 15; echo $payload_b64 | base64 -d > \"\$t\" || { echo rrun: remote decode failed >&2; exit 125; }; $shell \"\$t\"'"
      fi
      ;;
  esac
  # Wrap outward from the final hop: each intermediate host runs
  #   ssh <next> '<armored inner command>'
  # where the quoted part is pure base64 — no hop ever parses a metacharacter
  # originating from an inner layer, so quoting never stacks. The hop layer
  # keeps the status-honest $(...) form (no single quotes inside — the layer
  # itself is single-quoted); trailing-newline stripping is harmless HERE
  # because the decoded text is rrun's own generated one-line ssh command,
  # never user payload bytes. `exec` keeps stdin attached to the next ssh, so
  # a streamed payload flows through the whole chain. Hop login shells must be
  # POSIX-capable.
  for ((i=${#hops[@]}-2; i>=0; i--)); do
    b=$(printf %s "$c" | base64 -w0)
    c="ssh -o BatchMode=yes ${hops[i+1]} 's=\$(echo $b | base64 -d) || { echo rrun: hop decode failed >&2; exit 125; }; exec bash -c \"\$s\"'"
  done
  printf %s "$c"
}

cmd=$(compose 0)
stream=0
if (( ${#cmd} > limit )); then
  stream=1
  cmd=$(compose 1)
  b64=$payload_b64
fi

# Backstop: even the streamed form is per-hop re-armored, so a very deep chain
# can still outgrow what execve will accept. Fail with advice rather than
# leaking "Argument list too long" from the exec itself.
if (( ${#cmd} > maxcmd )); then
  echo "rrun: composed command is ${#cmd} chars, over the ${maxcmd} limit (${#hops[@]} hops); use -J <hops> instead — ProxyJump is a single connection" >&2
  exit 2
fi

sshopts=(-o BatchMode=yes)
if [[ -n $jump ]]; then
  sshopts+=(-J "$jump")
fi

if (( dry )); then
  # %q on EVERY argv element makes the printed command paste-safe: the composed
  # remote command ("| base64 -d | bash") would otherwise execute LOCALLY when
  # pasted, and a metacharacter-bearing -J argument would do the same.
  dryout=$(printf '%q ' ssh "${sshopts[@]}" "${hops[0]}" "$cmd")
  if (( stream )); then
    printf 'printf %%s %s | %s\n' "$b64" "${dryout% }"
  else
    printf '%s\n' "${dryout% }"
  fi
  exit 0
fi

if (( stream )); then
  # Judge success by the ssh element ALONE. If a big streamed script exits
  # before reading all of stdin, the channel closes while printf still has
  # data: printf dies with SIGPIPE (141) and pipefail would report that even
  # though the REMOTE COMMAND SUCCEEDED. PIPESTATUS[1] is ssh's own status
  # (which is the remote exit code, or 255 for transport errors).
  set +e +o pipefail
  printf %s "$b64" | ssh "${sshopts[@]}" "${hops[0]}" "$cmd"
  exit "${PIPESTATUS[1]}"
fi
exec ssh "${sshopts[@]}" "${hops[0]}" "$cmd"

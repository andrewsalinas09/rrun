* text=auto
# Shell payloads MUST stay LF — CRLF breaks shebangs and function bodies in WSL/Git Bash
bin/rrun            text eol=lf
bin/rrun-shim.bash  text eol=lf
profile/*.sh        text eol=lf
tests/*.sh          text eol=lf
hooks/*.sh          text eol=lf
hooks/*.py          text eol=lf
tests/*.py          text eol=lf
# matrix files enter Linux containers verbatim -- CRLF breaks shebangs/Dockerfiles
tests/matrix/**     text eol=lf
*.ps1               text eol=crlf
*.md                text
